{
  "name": "@veto-hq/agent-sdk",
  "version": "0.1.0",
  "private": false,
  "description": "TypeScript client for one charge, for reading a mandate and its decisions, and for a Hold vault.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arlencho/veto.git",
    "directory": "sdk"
  },
  "homepage": "https://github.com/Arlencho/veto",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc && node -e \"require('node:fs').cpSync('idl', 'dist/idl', { recursive: true })\"",
    "test": "tsx --test src/*.test.ts",
    "typecheck:examples": "tsc --noEmit -p tsconfig.test.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "~5.8.3"
  },
  "keywords": [
    "veto",
    "solana",
    "agents",
    "payments",
    "sdk"
  ]
}
