# Copy to watcher/.env if you want file-based config. The watcher and the
# terminal both read this file, terminal/.env, and keys/devnet-addresses.env
# (public addresses only). Keys may be VETO_RPC= or RPC=. Keypair paths stay
# under gitignored keys/. Never commit a real .env.
#
# Identity lines are commented placeholders. They do not resolve. Uncomment
# and supply a value; copying this file as-is leaves those variables unset.
#
# VETO_RPC is one JSON-RPC URL, or a comma-separated list. First is tried first.
# Put a dedicated endpoint first and keep the public cluster URL as fallback.
# A 429 walks the rest and is logged as a rate limit, not a failure.

# VETO_RPC=<json-rpc url>[,<fallback url>...]
# VETO_PROGRAM_ID=<base58>
# VETO_MINT=<base58>
# VETO_OWNER=<base58>
# VETO_OWNER_TOKEN=<base58>
# VETO_MERCHANT=<base58>
# VETO_MERCHANT_TOKEN=<base58>
# VETO_AGENT=<base58>

VETO_KEYS_DIR=../keys
VETO_JOURNAL=./data/decisions.jsonl
# Optional. When set, the journal is read from this object at the start of a
# run and written back after each decision. The local file path stays the
# default when this is unset.
# VETO_JOURNAL_GCS=gs://your-bucket/decisions.jsonl
# Optional. Comma-separated Hold vault addresses. When set, the watcher
# records one alert per hold: at creation, at 1 hour, at 12 hours, every
# 12 hours after that, at 6 hours and 1 hour before unlock, and when the
# hold ends (paid, stopped, recovered, or skipped). Each alert is written
# once to hold-alerts.jsonl next to the decision journal. Unset means the
# mandate loop only.
# VETO_HOLD_VAULTS=

VETO_MANDATE_ID=1
# Optional. Other open rules that name this agent, charged per pass. Default
# 25, at most 100, 0 turns it off. See README "Every rule that names the agent".
# VETO_AGENT_RULES_MAX=25
# Optional. No new charge in that pass starts after this many milliseconds.
# VETO_AGENT_PASS_BUDGET_MS=480000
# Optional. Timeout waiting for RPC response headers from one endpoint, in milliseconds. Body reads are outside this timeout.
# VETO_RPC_TIMEOUT_MS=20000
VETO_KWH_MILLI=50000
VETO_MINT_DECIMALS=6
# Optional. USD converts the SEK spot into USDC with the ECB daily reference rate before the charge, and unset or SEK keeps 1 token as 1 SEK.
# VETO_QUOTE_CURRENCY=USD

# Optional indexed demo request shaping. See docs/DEVNET.md for the budget,
# deterministic refusal schedule, and operator checks before switching it on.
# Existing spot arithmetic is the default; set to 1 to enable.
VETO_DEMO_CALIBRATION=0
# VETO_DEMO_CAP=20000000
# VETO_DEMO_PER_TX_MAX=500000
# VETO_DEMO_DAYS=40
# VETO_DEMO_REFUSAL_HOURS=6,18
